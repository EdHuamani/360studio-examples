# Credencial de sandbox, con payment_coupons:write y payment_coupons:read.
# El secreto permanece en el servidor. No subir .env ni compartirlo con capturas.
STUDIO_API_KEY=
# Obligatorio en esta API de clientes /v1: se envía como header x-workspace-id.
# Debe estar habilitado para Payments y autorizado para la credencial.
# No se envía workspace_id en el body.
STUDIO_WORKSPACE_ID=
# Prefijo de recaudo asignado al negocio, por ejemplo ACA (usar el propio).
STUDIO_PAYMENT_PREFIX=
PORT=3000
